# Backend config. Set these on the host (Render / Railway / Fly / …).

# Port to listen on. Hosts usually inject this automatically; defaults to 3001.
PORT=3001

# Legacy shared token — only used when there is NO database (single global room).
# When set, it must match VITE_RELAY_TOKEN in the client build. Ignored once orgs
# are enabled (a database is configured). Leave unset for an open LAN relay.
RELAY_TOKEN=

# Postgres connection string. Its presence enables durable incident history AND
# multi-tenant orgs + supervisor accounts (per-org rooms, email/password login).
# Leave unset to run the relay in-memory only (single room, no accounts). On
# Render this is wired automatically from the database in render.yaml.
# Example: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Secret used to sign supervisor session tokens (JWT). Set a long random string in
# production. If unset the server uses an ephemeral secret (sessions reset on
# restart) — fine for local dev only.
JWT_SECRET=
