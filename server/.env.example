# Backend config. Set these on the host (Render / Railway / Fly / …).

# Port to listen on. Hosts usually inject this automatically; defaults to 3001.
PORT=3001

# Shared token clients must present to connect. Leave unset for an open LAN relay.
# When set, it must match VITE_RELAY_TOKEN in the client build.
RELAY_TOKEN=

# Postgres connection string for durable incident history. Leave unset to run the
# relay in-memory only (no persistence, no REST history). On Render this is wired
# automatically from the database in render.yaml.
# Example: postgres://user:pass@host:5432/dbname
DATABASE_URL=
