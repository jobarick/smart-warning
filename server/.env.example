# Backend config. Set these on the host (Render / Railway / Fly / …).

# Port to listen on. Hosts usually inject this automatically; defaults to 3001.
PORT=3001

# Legacy shared token — only used when there is NO database (single global room).
# When set, it must match VITE_RELAY_TOKEN in the client build. Ignored once orgs
# are enabled (a database is configured). Leave unset for an open LAN relay.
RELAY_TOKEN=

# Postgres connection string. Its presence enables durable incident history AND
# multi-tenant orgs + supervisor accounts (per-org rooms, email/password login).
# Leave unset to run the relay in-memory only (single room, no accounts). On
# Render this is wired automatically from the database in render.yaml.
# Example: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Secret used to sign supervisor session tokens (JWT). Set a long random string in
# production. If unset the server uses an ephemeral secret (sessions reset on
# restart) — fine for local dev only.
JWT_SECRET=

# Web push (VAPID). Optional: if unset, the server generates a keypair on first
# boot and stores it in the database, so push works with no configuration. Set
# these only to pin your own keys. Generate a pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI included in push requests (some push services require it).
VAPID_SUBJECT=mailto:alerts@example.com

# Firebase Cloud Messaging (Android native push, closed-app delivery). Optional:
# if unset, native push stays disabled and web push is unaffected. Provide ONE of:
#   FIREBASE_SERVICE_ACCOUNT       — service account JSON, or its base64 (recommended
#                                    on hosting panels that mangle multi-line PEMs)
#   GOOGLE_APPLICATION_CREDENTIALS — path to the service account JSON file on disk
# See docs/FIREBASE_SETUP.md for how to generate the key.
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=

# SMTP email delivery. Optional: without it, mail queues in outbound_mail and
# delivers itself retroactively once SMTP_URL is set (nothing is lost). Use
# smtps:// for implicit TLS (port 465) or smtp:// for STARTTLS (port 587);
# percent-encode any @ : / ? in the password.
#   Example: smtps://user:pass@smtp.gmail.com:465
# See docs/SMTP_SETUP.md for provider selection and troubleshooting.
SMTP_URL=
# From header on outgoing mail. Defaults to "Smart Warning <no-reply@smart-warning.app>".
SMTP_FROM=
# Recipient for the feedback form. Defaults to jobarick@gmail.com.
FEEDBACK_TO=
# Force a provider instead of the automatic choice: smtp | log | none.
MAIL_PROVIDER=
