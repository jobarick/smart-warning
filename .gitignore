# Dependencies
node_modules/

# Python
.venv/
__pycache__/
*.pyc

# Build output
dist/
dev-dist/
dist-ssr/
*.local

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.*
!.env.example
# Committed deliberately: only the public relay URL, so production builds need
# no dashboard env vars. Never put secrets in it.
!client/.env.production

# Editor / OS
# Shared editor config is committed on purpose: the TS SDK pin keeps editor
# errors identical to `tsc`, and the launch configs are how you run the two
# halves together. Everything else under .vscode stays local.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
.DS_Store
Thumbs.db
