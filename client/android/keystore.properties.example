# Release signing configuration for the Play Store build.
#
# Copy to keystore.properties (which is gitignored) and fill in. The build
# reads these, or the equivalent environment variables for CI:
#
#   ANDROID_KEYSTORE_FILE      →  storeFile
#   ANDROID_KEYSTORE_PASSWORD  →  storePassword
#   ANDROID_KEY_ALIAS          →  keyAlias
#   ANDROID_KEY_PASSWORD       →  keyPassword
#
# Create the keystore once (see docs/ANDROID_RELEASE.md for the full walkthrough):
#
#   keytool -genkeypair -v -keystore smart-warning-upload.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias smart-warning
#
# BACK THE .jks FILE UP SOMEWHERE THAT IS NOT THIS MACHINE. If it is lost,
# Google Play will not accept another update to com.smartwarning.app ever
# again — the listing would have to be republished under a new package name,
# and every existing installation would be stranded on its current version.
# For an app people rely on in an emergency, that is not a recoverable mistake.
#
# An absolute path is safest; a relative one is resolved from client/android/.
storeFile=C:\\path\\to\\smart-warning-upload.jks
storePassword=
keyAlias=smart-warning
keyPassword=
