<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Backup is off deliberately. The webview's localStorage holds the
         signed-in session (sw-session-v1), and that token is what lets a
         device see the live position of everyone on a site. With backup on,
         Android copies it to the user's Google account and restores it onto
         whatever device they set up next — including a replacement phone in
         somebody else's hands. The cost of turning it off is that a restored
         device asks the person to sign in again, which is the correct thing
         for it to ask. dataExtractionRules covers the Android 12+ paths that
         allowBackup alone does not, notably device-to-device transfer. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Where a notification lands when it arrives with the app killed and
             FCM has no channel to put it on. Without this, Android drops such
             messages onto a low-importance default channel that does not make a
             sound — an emergency alert that arrives silently is not an alert.
             The channels themselves are created at runtime (see nativePush.ts)
             so their copy stays with the rest of the product's wording. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="sw_emergency" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 13+ requires an explicit runtime grant before an app may post
         notifications at all. Without this declaration the request cannot even
         be shown, and every push would be delivered to a device that silently
         discards it. Requested at registration time, not at first launch, so
         the prompt arrives with a reason attached. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The emergency channel vibrates; on older releases that needs a grant. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The worker screen reads position for the map, the assembly-point
         distance and the roster it reports to supervisors. The webview's
         geolocation prompt can only be granted if the app holds these. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Android 11+ hides other apps unless they are declared here. Without this
         the webview's tel:/mailto:/geo: links resolve to nothing and silently do
         nothing — which, for the emergency call pocket, is the worst possible
         failure. Declaring DIAL (not CALL) is deliberate: it opens the dialler
         with the number filled in and lets the person press call, so the app
         needs no CALL_PHONE permission and cannot dial by accident. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
