# Production build config, committed on purpose.
#
# This is the public address of the hosted relay/API — not a secret (the browser
# reveals it on every connection anyway). Baking it in means a production deploy
# needs no dashboard environment variables: `vite build` picks this up
# automatically, and a host env var of the same name still overrides it.
#
# VITE_API_URL is intentionally unset — the REST base is derived from this
# (ws->http, wss->https), since the relay and the API share a host.
VITE_WS_URL=wss://smart-warning-relay-6lf3.onrender.com
