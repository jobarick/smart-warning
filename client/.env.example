# Client build-time config (Vite). Copy to .env.local for dev, or set these as
# environment variables on Vercel. All must be prefixed VITE_ to be exposed.

# Public URL of the relay's WebSocket. Leave unset for LAN/dev — the client then
# uses ws(s)://<current-host>:3001 automatically.
VITE_WS_URL=

# Base URL of the backend's REST history API (supervisor incident history). Leave
# unset to derive it from VITE_WS_URL (ws→http, wss→https), which is correct when
# both run on the same host — so you normally only set VITE_WS_URL.
VITE_API_URL=

# Shared token that must match RELAY_TOKEN on the relay. Leave unset for an open
# (unauthenticated) LAN relay. Required for a safe public deployment.
VITE_RELAY_TOKEN=
